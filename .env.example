# ===== Telegram User Bot (Pyrogram) — listen only =====
API_ID=your_api_id
API_HASH=your_api_hash
PHONE_NUMBER=+1234567890

# ===== Telegram Sender Bot (Bot API) — sends to destinations =====
BOT_TOKEN=your_sender_bot_token

# ===== Telegram Alert Bot — sends health alerts to you =====
ALERT_BOT_TOKEN=your_alert_bot_token
ALERT_CHAT_ID=your_personal_chat_id

# ===== Webhook Security =====
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=generate-a-64-char-random-string-here

# ===== n8n (uses Docker service name — do NOT change to localhost) =====
N8N_WEBHOOK_URL_MESSAGE=http://n8n:5678/webhook/message
N8N_WEBHOOK_URL_ALBUM=http://n8n:5678/webhook/album
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_to_strong_password
# Required: allows n8n workflow nodes to read WEBHOOK_SECRET via process.env
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# ===== Redis (uses Docker service name — do NOT change to localhost) =====
REDIS_URL=redis://redis:6379/0

# ===== SQLite (absolute path inside container — do NOT change) =====
DB_PATH=/app/data/forwarder.db

# ===== Tuning =====
WORKER_COUNT=2
WORKER_DELAY_MIN=0.5
WORKER_DELAY_MAX=1.5
ALBUM_BUFFER_SECONDS=2.0
HEALTH_CHECK_INTERVAL=300
MAX_RETRIES=3
LOG_LEVEL=INFO
