# ===== Telegram User Bot (Hydrogram) — listen only =====
API_ID=your_api_id
API_HASH=your_api_hash
PHONE_NUMBER=+1234567890

# ===== Telegram Sender Bot (Bot API) — sends to destinations =====
BOT_TOKEN=your_sender_bot_token

# ===== Telegram Alert Bot — sends health alerts to you =====
ALERT_BOT_TOKEN=your_alert_bot_token
ALERT_CHAT_ID=your_personal_chat_id


# ===== Redis (uses Docker service name — do NOT change to localhost) =====
REDIS_URL=redis://redis:6379/0

# ===== SQLite (absolute path inside container — do NOT change) =====
DB_PATH=/app/data/forwarder.db

# Recommended: private relay channel for media (userbot + sender bot both admin)
RELAY_CHANNEL_ID=-1001234567890
# Optional: override Hydrogram session directory (default: /app/sessions)
# PYROGRAM_WORKDIR is accepted as a legacy fallback.
# HYDROGRAM_WORKDIR=/app/sessions
WORKER_COUNT=2
WORKER_DELAY_MIN=0.5
WORKER_DELAY_MAX=1.5
ALBUM_BUFFER_SECONDS=2.0
HEALTH_CHECK_INTERVAL=300
MAX_RETRIES=3
LOG_LEVEL=INFO

# ===== Daily health report (alert bot → ALERT_CHAT_ID) =====
# Sent at DAILY_REPORT_HOUR in DAILY_REPORT_TIMEZONE (default 08:00 UTC+3)
DAILY_REPORT_ENABLED=true
DAILY_REPORT_HOUR=8
DAILY_REPORT_TIMEZONE=Etc/GMT-3
# Set true once to force a report on container start (useful for testing)
DAILY_REPORT_RUN_ON_START=false
